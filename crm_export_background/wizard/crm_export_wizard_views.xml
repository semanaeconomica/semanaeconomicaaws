<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_export_wizard_form" model="ir.ui.view">
        <field name="name">crm.export.wizard.form</field>
        <field name="model">crm.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar Oportunidades">
                <group attrs="{'invisible': [('state', '=', 'done')]}">
                    <field name="export_mode" widget="radio"/>
                    <field name="total_to_export" string="Registros a exportar"/>
                    <p><strong>Esto puede tomar unos minutos dependiendo de la cantidad de registros.</strong></p>
                </group>
                <group attrs="{'invisible': [('state', '=', 'draft')]}">
                    <field name="record_count"/>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <field name="state" invisible="1"/>
                <footer>
                    <button name="action_export" string="Generar Excel" type="object" class="btn-primary" attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_export_wizard" model="ir.actions.act_window">
        <field name="name">Exportar Oportunidades a Excel</field>
        <field name="res_model">crm.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
